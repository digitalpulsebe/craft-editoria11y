{#{% import '_includes/forms.twig' as forms %}#}

{% do view.registerAssetBundle("digitalpulsebe\\editorially\\assets\\EditoriallyVendorBundle") %}

<fieldset>
    <legend class="h6">Accessibility checks</legend>
    <div class="meta">

        <div class="field">
            <div class="heading" style="flex:1">
                Warnings found:
                <span id="editoria11y-check-result">...</span>
                <craft-tooltip placement="bottom" max-width="200" text="Does not check non-saved changes" delay="1000">
                    <button type="button" class="prevent-autofocus" data-icon="info" aria-label="Does not check non-saved changes" style="pointer-events: auto;">
                    </button>
                </craft-tooltip>
            </div>
            <div class="input" style="flex:0">
                <a href="{{ actionUrl('editoria11y/session/start', {redirect: element.url}) }}" target="_blank" title="Start accessibility check in new tab">
                    <span data-icon="external"></span>
                </a>
            </div>
        </div>
    </div>
</fieldset>

<div id="editoria11y-check-container" style="height:0; overflow:hidden;"></div>

<script type="application/javascript">
    window.addEventListener('load', () => {
        const resultSpan = document.getElementById('editoria11y-check-result');

        fetch('{{ element.url }}')
            .then(response => response.ok ? response.text() : null)
            .then(function(html) {
                if (!html) {
                    resultSpan.parentElement.innerHTML = "Unable to reach preview.";
                    return;
                }

                // 1. Parse string into a real DOM object
                const parser = new DOMParser();
                const doc = parser.parseFromString(html, 'text/html');

                // 2. Efficiently remove unwanted elements
                const toRemove = doc.querySelectorAll('script, head, iframe, noscript, style');
                toRemove.forEach(el => el.remove());

                // 3. Extract the 'lang' attribute!
                // Important: WCAG requires a lang attribute. Ed11y checks this.
                const pageLang = doc.documentElement.getAttribute('lang') || 'en';

                const container = document.getElementById('editoria11y-check-container');
                container.setAttribute('lang', pageLang);
                container.innerHTML = doc.body.innerHTML;

                // 4. Run Editoria11y
                if (typeof Ed11y !== 'undefined') {
                    new Ed11y({
                        checkRoots: '#editoria11y-check-container',
                        alertMode: "headless",
                    });

                    document.addEventListener('ed11yResults', function() {
                        // Ed11y.errors specifically counts 'Red' critical issues
                        // Ed11y.results contains all issues (including warnings)
                        const errorCount = Ed11y.results.length;
                        resultSpan.innerHTML = `<strong>${errorCount}</strong>`;

                        if (errorCount > 0) {
                            // Apply warning style to the wrapper
                            const fieldWrapper = resultSpan.closest('.field');
                            if (fieldWrapper) {
                                fieldWrapper.style.backgroundColor = '#fee2e2'; // --red-100
                                fieldWrapper.style.borderLeft = '4px solid #dc2626'; // --red-600
                            }
                        }
                    }, { once: true });
                }
            })
            .catch(err => {
                console.error('Ed11y Error:', err);
                resultSpan.innerText = 'Error';
            });
    })
</script>